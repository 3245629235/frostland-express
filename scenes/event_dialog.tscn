[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/event_dialog.gd" id="1_event"]

[node name="EventDialog" type="PanelContainer"]
custom_minimum_size = Vector2(480, 300)
mouse_filter = 0
script = ExtResource("1_event")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "事件"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 60)
text = "事件描述"
autowrap_mode = 2

[node name="ChoiceBox" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

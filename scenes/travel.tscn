[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/travel.gd" id="1_script"]

[node name="Travel" type="Node2D"]
script = ExtResource("1_script")
walk_speed = 250.0

; ---- 雪原视差层（survival 原版 5 层，含 y_off 与 z 序）----

[node name="Layer0Sky" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
z_index = 0

[node name="Layer1FarCloud" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
z_index = 1

[node name="Layer2MidCloud" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
z_index = 2

[node name="Layer3Ground" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
z_index = 3

[node name="Layer4FrontTree" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
z_index = 6

; ---- 列车展示（车厢精灵 + 裁剪，支持拖拽浏览全貌）----

[node name="TrainContainer" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
clip_contents = true
z_index = 5

; ---- 车厢内交互点（挂在列车容器内，随列车移动/裁剪）----

[node name="InteractionRoot" type="Node2D" parent="TrainContainer"]

; ---- 随车小队 / HUD ----

[node name="CrewRoot" type="Node2D" parent="."]
z_index = 10

[node name="HUD" type="CanvasLayer" parent="."]

[node name="TopBar" type="VBoxContainer" parent="HUD"]
offset_left = 12.0
offset_top = 12.0
offset_right = 420.0
offset_bottom = 170.0

[node name="StatusLabel" type="Label" parent="HUD/TopBar"]
custom_minimum_size = Vector2(400, 44)
text = "速度 -- km/h"
vertical_alignment = 1

[node name="CarriageLabel" type="Label" parent="HUD/TopBar"]
custom_minimum_size = Vector2(400, 20)
text = "编组: --"

[node name="AccelButton" type="Button" parent="HUD/TopBar"]
custom_minimum_size = Vector2(200, 44)
layout_mode = 0
text = "加速"

[node name="BrakeButton" type="Button" parent="HUD/TopBar"]
custom_minimum_size = Vector2(200, 44)
layout_mode = 0
text = "刹车"

[node name="BackButton" type="Button" parent="HUD/TopBar"]
custom_minimum_size = Vector2(200, 44)
layout_mode = 0
text = "返回主界面"

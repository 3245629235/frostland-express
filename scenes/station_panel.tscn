[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/station_panel.gd" id="1_station"]

[node name="StationPanel" type="PanelContainer"]
custom_minimum_size = Vector2(760, 280)
mouse_filter = 0
script = ExtResource("1_station")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18

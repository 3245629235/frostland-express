extends Node
# ===== 资源类型 =====
enum ResourceType { FOOD, FUEL, MEDICINE, PARTS, AMMO_SMALL, AMMO_LARGE }

const RESOURCE_STR = {
	ResourceType.FOOD: "food",
	ResourceType.FUEL: "fuel",
	ResourceType.MEDICINE: "medicine",
	ResourceType.PARTS: "parts",
	ResourceType.AMMO_SMALL: "ammo_small",
	ResourceType.AMMO_LARGE: "ammo_large",
}

const STR_RESOURCE = {
	"food": ResourceType.FOOD,
	"fuel": ResourceType.FUEL,
	"medicine": ResourceType.MEDICINE,
	"parts": ResourceType.PARTS,
	"ammo_small": ResourceType.AMMO_SMALL,
	"ammo_large": ResourceType.AMMO_LARGE,
}

const RESOURCE_NAMES = {
	ResourceType.FOOD: "食物",
	ResourceType.FUEL: "燃料",
	ResourceType.MEDICINE: "药品",
	ResourceType.PARTS: "零件",
	ResourceType.AMMO_SMALL: "小口径弹药",
	ResourceType.AMMO_LARGE: "大口径弹药",
}

# ===== 游戏状态单例（Autoload） =====
var resources: Dictionary = {}
var characters: Array = []
var train: Dictionary = {}
var morale: float = 50.0
var is_traveling: bool = false
var travel_time: float = 0.0
var current_node: String = "station_start"

# ===== 初始化 =====
func _ready() -> void:
	_reset_resources()
	_reset_train()
	load_state()

func _reset_resources() -> void:
	resources = {
		"food": 1000,
		"fuel": 1000,
		"medicine": 1000,
		"parts": 1000,
		"ammo_small": 1000,
		"ammo_large": 1000,
	}

func _reset_train() -> void:
	train = {
		"health": 100.0,
		"max_health": 100.0,
		"speed": 0.0,
		"carriages": [],
		"locomotive_count": 0,
		"total_mass": 0.0,
	}

# ===== 完整重置 =====
func full_reset() -> void:
	_reset_resources()
	_reset_train()
	characters = []
	morale = 50.0
	is_traveling = false
	travel_time = 0.0
	current_node = "station_start"

# ===== 重置资源为默认值（通过公开方法） =====
func reset_resources() -> void:
	_reset_resources()

# ===== 资源操作 =====
func get_resource(type_str: String) -> int:
	return resources.get(type_str, 0)

func add_resource(type_str: String, amount: int) -> void:
	resources[type_str] = resources.get(type_str, 0) + amount

func consume_resource(type_str: String, amount: int) -> bool:
	if resources.get(type_str, 0) >= amount:
		resources[type_str] -= amount
		return true
	return false

# ===== 列车状态 =====
func set_train_health(health: float) -> void:
	train["health"] = clamp(health, 0, train["max_health"])

func damage_train(amount: float) -> void:
	set_train_health(train["health"] - amount)

func repair_train(amount: float) -> void:
	set_train_health(train["health"] + amount)

func get_train_efficiency() -> float:
	return train["health"] / train["max_health"]

# ===== 编组数据同步（由 team.gd 在保存编组时调用） =====
# carriages: Array[Dictionary] 每个元素 { "type": "locomotive", "flipped": false }
# 运行时会自动补充: fuel_left, is_powered, health（从 VehicleTypes 初始化，同位置同类型则保留旧值）
func update_train_composition(carriages: Array) -> void:
	var old = train["carriages"]
	train["carriages"] = carriages.duplicate(true)
	for i in range(train["carriages"].size()):
		var c = train["carriages"][i]
		var type_str = c.get("type", "")
		var vtype = VehicleTypes.STR_TYPE.get(type_str)
		if vtype == null:
			continue
		var cfg = VehicleTypes.CONFIG[vtype]
		# 同位置同类型 → 保留运行时状态；否则初始化
		var preserve = i < old.size() and old[i].get("type") == type_str
		if type_str == "coal_tender":
			c["fuel_left"] = old[i].get("fuel_left", cfg["coal_capacity"]) if preserve else cfg["coal_capacity"]
		else:
			c["fuel_left"] = old[i].get("fuel_left", 0.0) if preserve else 0.0
		c["health"] = old[i].get("health", cfg["durability"]) if preserve else cfg["durability"]
		if type_str == "locomotive":
			c["is_powered"] = true  # 初步标记，_recalc_train_stats 中重新校验
		else:
			c["is_powered"] = true
	_recalc_train_stats()
	# 校验机车动力（煤水车可能不够）
	_refresh_loco_power()

func refresh_train_runtime_state() -> void:
	_recalc_train_stats()
	_refresh_loco_power()

func _recalc_train_stats() -> void:
	var loco_count = 0
	var total_mass = 0.0
	for c in train["carriages"]:
		var type_str = c.get("type", "")
		var vtype = VehicleTypes.STR_TYPE.get(type_str)
		if vtype != null:
			total_mass += VehicleTypes.CONFIG[vtype].get("mass", 0)
			if type_str == "locomotive":
				loco_count += 1
	train["locomotive_count"] = loco_count
	train["total_mass"] = total_mass

# ---- 机车动力校验 ----
# 每台机车在自己的朝向方向上找到最近的煤水车，有燃料 → 有动力
func _refresh_loco_power() -> void:
	for i in range(train["carriages"].size()):
		var c = train["carriages"][i]
		if c["type"] != "locomotive":
			continue
		var tender_idx = _find_coal_tender(i, c.get("flipped", false))
		c["is_powered"] = tender_idx >= 0

func _find_coal_tender(loco_idx: int, flipped: bool) -> int:
	if flipped:
		for j in range(loco_idx - 1, -1, -1):
			var c = train["carriages"][j]
			if c["type"] == "locomotive" or _is_cargo_type(c["type"]):
				break
			if c["type"] == "coal_tender" and c.get("fuel_left", 0) > 0:
				return j
	else:
		for j in range(loco_idx + 1, train["carriages"].size()):
			var c = train["carriages"][j]
			if c["type"] == "locomotive" or _is_cargo_type(c["type"]):
				break
			if c["type"] == "coal_tender" and c.get("fuel_left", 0) > 0:
				return j
	return -1

func _is_cargo_type(type_str: String) -> bool:
	return type_str == "passenger" or type_str == "open_car" or type_str == "tank_car" or type_str == "service_car" or type_str == "combat_car"

# ===== 列车物理引擎（每帧调用） =====
# F_tract = Σ(有动力机车 tractive_power)
# F_aero  = Σ(drag_coefficient) × AERO_FACTOR × v²
# F_net   = F_tract - F_aero
# a       = F_net / m_total
#   v       = v + a × dt
#
# is_driven: 是否在行驶中。停车时 false，牵引力为 0，列车仅受风阻自然减速
func _update_train_physics(delta: float, is_driven: bool = true) -> void:
	var dt = delta
	
	# ---- 牵引力（停车时无效） ----
	var f_tract = 0.0
	if is_driven:
		for c in train["carriages"]:
			if c["type"] == "locomotive" and c.get("is_powered", false):
				f_tract += VehicleTypes.CONFIG[VehicleTypes.STR_TYPE["locomotive"]]["tractive_power"]
	
	var total_drag = 0.0
	var total_mass = 0.0
	for c in train["carriages"]:
		var vtype = VehicleTypes.STR_TYPE.get(c["type"])
		if vtype != null:
			total_drag += VehicleTypes.CONFIG[vtype]["drag_coefficient"]
			total_mass += VehicleTypes.CONFIG[vtype]["mass"]
	
	var speed = train.get("speed", 0.0)
	if speed == null:
		speed = 0.0
	var f_aero = total_drag * GameConfig.AERO_FACTOR * speed * speed
	var f_net = f_tract - f_aero
	
	if f_net <= 0 and speed <= 0.01:
		train["speed"] = 0.0
		return
	
	var a = f_net / total_mass
	speed += a * dt
	if speed < 0:
		speed = 0.0
	train["speed"] = speed

# 燃料消耗（由 main/survival 每 CONSUME_INTERVAL 调用一次）
# interval: 距上次调用的时间（秒）
# 同时扣除煤水车本地燃料和全局燃料池，保持同步
func consume_train_fuel(interval: float) -> void:
	for i in range(train["carriages"].size()):
		var c = train["carriages"][i]
		if c["type"] != "locomotive" or not c.get("is_powered", false):
			continue
		var tender_idx = _find_coal_tender(i, c.get("flipped", false))
		if tender_idx < 0:
			c["is_powered"] = false
			continue
		var tender = train["carriages"][tender_idx]
		var consume = VehicleTypes.CONFIG[VehicleTypes.STR_TYPE["locomotive"]]["fuel_consume"] * interval
		if tender["fuel_left"] >= consume:
			tender["fuel_left"] -= consume
			consume_resource("fuel", int(ceil(consume)))
		else:
			consume_resource("fuel", int(ceil(tender["fuel_left"])))
			tender["fuel_left"] = 0
			c["is_powered"] = false

# ===== 查询接口 =====
func get_train_speed() -> float:
	var s = train.get("speed", 0.0)
	return s if s != null else 0.0

func get_train_fuel_consumption() -> float:
	var total = 0.0
	for c in train["carriages"]:
		if c["type"] == "locomotive" and c.get("is_powered", false):
			total += VehicleTypes.CONFIG[VehicleTypes.STR_TYPE["locomotive"]]["fuel_consume"]
	return total

func get_train_mass_burden() -> float:
	var loco_count = train.get("locomotive_count", 0)
	var total_mass = train.get("total_mass", 0.0)
	if loco_count <= 0:
		return 1.0
	return max(total_mass / (loco_count * 100.0), 1.0)

# 获取各机车动力状态（UI 展示用）
func get_loco_power_status() -> Array:
	var status: Array = []
	for c in train["carriages"]:
		if c["type"] == "locomotive":
			status.append(c.get("is_powered", false))
	return status

# 获取煤水车燃料余量（UI 展示用）
func get_tender_fuel_levels() -> Array:
	var levels: Array = []
	for c in train["carriages"]:
		if c["type"] == "coal_tender":
			var fuel = c.get("fuel_left", 0.0)
			var vtype = VehicleTypes.STR_TYPE.get("coal_tender")
			var cap = 0.0
			if vtype != null:
				cap = VehicleTypes.CONFIG[vtype]["coal_capacity"]
			levels.append({"fuel": fuel, "capacity": cap})
	return levels

# ===== 保存/加载 =====
func save_state() -> void:
	var save_data = {
		"resources": resources,
		"characters": characters,
		"train": train,
		"morale": morale,
		"is_traveling": is_traveling,
		"travel_time": travel_time,
		"current_node": current_node,
	}
	var file = FileAccess.open("user://game_state.json", FileAccess.WRITE)
	if file:
		file.store_string(JSON.stringify(save_data))
		file.close()

func load_state() -> bool:
	if not FileAccess.file_exists("user://game_state.json"):
		return false
	var file = FileAccess.open("user://game_state.json", FileAccess.READ)
	if not file:
		return false
	var content = file.get_as_text()
	file.close()
	var data = JSON.parse_string(content)
	if data == null:
		return false
	if data.has("resources"):
		resources = data["resources"]
	if data.has("characters"):
		characters = data["characters"]
	if data.has("train"):
		train = data["train"]
	if data.has("morale"):
		morale = float(data["morale"])
	if data.has("is_traveling"):
		is_traveling = bool(data["is_traveling"])
	if data.has("travel_time"):
		travel_time = float(data["travel_time"])
	if data.has("current_node"):
		current_node = data["current_node"]
	refresh_train_runtime_state()
	return true

# 场景退出时自动保存
func _exit_tree() -> void:
	save_state()

# ===== 旅行消耗计算 =====
func calculate_travel_consumption(duration: float) -> Dictionary:
	var consumption = {
		"food": int(duration * 2),
		"fuel": int(duration * 3),
	}
	return consumption

func apply_travel_consumption(consumption: Dictionary) -> bool:
	for key in consumption.keys():
		if not consume_resource(key, consumption[key]):
			return false
	return true

extends Control

# ===== 可在编辑器中调整的参数 =====
@export var wall_speed_ratio: float = 0.8
@export var cf_speed_ratio: float = 1.0
@export var rail_y_ratio: float = 0.85
@export var vehicle_height_ratio: float = 0.36
@export var card_panel_height: float = 200.0
@export var card_size: Vector2 = Vector2(140, 140)
@export var train_start_x_ratio: float = 0.1
@export var initial_locomotive_count: int = 2
@export var initial_coal_tender_count: int = 3

# ===== 节点引用 =====
@onready var back_button: Button = $BackButton
@onready var debug_label: Label = $DebugLabel
@onready var wall_container: Control = $WallContainer
@onready var cf_container: Control = $CeilingFloorContainer
@onready var build_menu: MenuButton = $BuildMenu
@onready var card_panel: Panel = $CardPanel
@onready var card_title: Label = $CardPanel/CardTitle
@onready var card_container: HBoxContainer = $CardPanel/CardContainer
@onready var clear_all_button: Button = $CardPanel/ClearAllButton
@onready var placed_vehicles_node: Control = $RailArea/PlacedVehicles
@onready var drag_preview: TextureRect = $DragPreview

# ===== 视差滚动变量 =====
var wall_texture: Texture2D
var cf_texture: Texture2D
var scroll_x: float = 0.0
var target_scroll: float = 0.0
var train_length: float = 3.0
var max_scroll: float = 0.0
var is_dragging_screen: bool = false
var drag_start_mouse_x: float = 0.0
var drag_start_scroll: float = 0.0
var last_mouse_x: float = 0.0
var momentum: float = 0.0
var view_w: float = 0.0
var view_h: float = 0.0
var wall_scaled_width: float = 0.0
var cf_scaled_width: float = 0.0

# ===== 车辆构建变量 =====
const TYPE_LOCOMOTIVE = "locomotive"
const TYPE_COAL_TENDER = "coal_tender"
const SAVE_PATH = "user://train_save.json"

var card_paths = {
	"locomotive": "res://assets/sprites/vehicles/locomotive/locomotive_card.png",
	"coal_tender": "res://assets/sprites/vehicles/coal_tender/coal_tender_card.png"
}
var vehicle_paths = {
	"locomotive": "res://assets/sprites/vehicles/locomotive/locomotive.png",
	"coal_tender": "res://assets/sprites/vehicles/coal_tender/coal_tender.png"
}
var type_names = {
	"locomotive": "机车",
	"coal_tender": "煤水车"
}

var card_textures = {}
var vehicle_textures = {}
var vehicle_scaled_widths = {}

# 玩家拥有的车辆数量
var player_inventory = {
	"locomotive": 2,
	"coal_tender": 3
}

var current_card_type: String = ""

# 已放置的车辆列表，每个元素: {type, width, flipped, node}
var placed_vehicles: Array = []

# 拖动状态：0=无, 1=从卡片拖出去放置, 2=从列车拖出去回收
var drag_mode: int = 0
var drag_card_type: String = ""
var drag_vehicle_index: int = -1
var drag_mouse_start: Vector2 = Vector2.ZERO
var has_dragged: bool = false

# 铁轨y位置
var rail_y: float = 0.0
var vehicle_target_height: float = 0.0

func _ready() -> void:
	back_button.pressed.connect(_on_back_pressed)
	clear_all_button.pressed.connect(_on_clear_all_pressed)
	_setup_build_menu()
	view_w = get_viewport().get_visible_rect().size.x
	view_h = get_viewport().get_visible_rect().size.y
	rail_y = view_h * rail_y_ratio
	vehicle_target_height = view_h * vehicle_height_ratio
	
	# 动态调整卡片面板高度
	card_panel.offset_top = -card_panel_height
	
	# 初始化库存
	player_inventory["locomotive"] = initial_locomotive_count
	player_inventory["coal_tender"] = initial_coal_tender_count
	
	# 加载视差纹理
	wall_texture = load("res://assets/sprites/wall.png") as Texture2D
	cf_texture = load("res://assets/sprites/ceiling_floor.png") as Texture2D
	if wall_texture == null or cf_texture == null:
		debug_label.text = "图片加载失败！"
		return
	
	var wall_scale: float = view_h / wall_texture.get_height()
	var cf_scale: float = view_h / cf_texture.get_height()
	wall_scaled_width = wall_texture.get_width() * wall_scale
	cf_scaled_width = cf_texture.get_width() * cf_scale
	_create_sprites(wall_container, wall_texture, wall_scaled_width, wall_scale)
	_create_sprites(cf_container, cf_texture, cf_scaled_width, cf_scale)
	
	max_scroll = cf_scaled_width * train_length - view_w
	if max_scroll < 0:
		max_scroll = 0
	
	# 加载车辆纹理
	_load_vehicle_textures()
	
	# 加载保存的编组
	_load_train_save()
	
	# 初始化拖动预览
	drag_preview.visible = false
	
	# 调试信息
	var inv_str = "库存:"
	for key in player_inventory.keys():
		inv_str += " " + type_names.get(key, key) + str(player_inventory[key])
	debug_label.text = inv_str + " | 已放置:" + str(placed_vehicles.size())

# ===== 视差滚动 =====
func _create_sprites(container: Control, tex: Texture2D, scaled_w: float, _scale_y: float) -> void:
	var count: int = int(ceil(view_w / scaled_w)) + 2
	for i in range(count):
		var t := TextureRect.new()
		t.texture = tex
		t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		t.stretch_mode = TextureRect.STRETCH_SCALE
		t.offset_left = i * scaled_w
		t.offset_top = 0
		t.offset_right = i * scaled_w + scaled_w
		t.offset_bottom = view_h
		t.mouse_filter = Control.MOUSE_FILTER_IGNORE
		container.add_child(t)

func _process(delta: float) -> void:
	if not is_dragging_screen:
		momentum *= 0.92
		target_scroll += momentum
		if target_scroll < 0:
			target_scroll = 0
			momentum = 0
		if target_scroll > max_scroll:
			target_scroll = max_scroll
			momentum = 0
	
	scroll_x = lerp(scroll_x, target_scroll, 10.0 * delta)
	_update_parallax_positions()
	if not placed_vehicles.is_empty():
		_rearrange_vehicles()

func _update_parallax_positions() -> void:
	var wall_off: float = fmod(scroll_x * wall_speed_ratio, wall_scaled_width)
	var cf_off: float = fmod(scroll_x * cf_speed_ratio, cf_scaled_width)
	
	var wall_children: Array[Node] = wall_container.get_children()
	for i in range(wall_children.size()):
		var sp: TextureRect = wall_children[i] as TextureRect
		if sp != null:
			var x: float = i * wall_scaled_width - wall_off
			while x < -wall_scaled_width:
				x += wall_scaled_width * wall_children.size()
			while x > view_w:
				x -= wall_scaled_width * wall_children.size()
			sp.offset_left = x
			sp.offset_right = x + wall_scaled_width
	
	var cf_children: Array[Node] = cf_container.get_children()
	for i in range(cf_children.size()):
		var sp: TextureRect = cf_children[i] as TextureRect
		if sp != null:
			var x: float = i * cf_scaled_width - cf_off
			while x < -cf_scaled_width:
				x += cf_scaled_width * cf_children.size()
			while x > view_w:
				x -= cf_scaled_width * cf_children.size()
			sp.offset_left = x
			sp.offset_right = x + cf_scaled_width

# ===== 车辆纹理加载 =====
func _load_vehicle_textures() -> void:
	for type in card_paths.keys():
		var ct = load(card_paths[type]) as Texture2D
		if ct != null:
			card_textures[type] = ct
	for type in vehicle_paths.keys():
		var vt = load(vehicle_paths[type]) as Texture2D
		if vt != null:
			vehicle_textures[type] = vt
			var scale_factor: float = vehicle_target_height / vt.get_height()
			vehicle_scaled_widths[type] = vt.get_width() * scale_factor

# ===== 构建菜单 =====
func _setup_build_menu() -> void:
	var popup: PopupMenu = build_menu.get_popup()
	popup.add_item("机车", 0)
	popup.add_item("煤水车", 1)
	popup.add_item("特殊机车", 2)
	popup.add_item("货车", 3)
	popup.add_item("客车", 4)
	popup.add_item("勤务车厢", 5)
	popup.add_item("战斗车厢", 6)
	popup.index_pressed.connect(_on_build_menu_selected)

func _on_build_menu_selected(index: int) -> void:
	var names: Array[String] = ["机车", "煤水车", "特殊机车", "货车", "客车", "勤务车厢", "战斗车厢"]
	var selected_name = names[index]
	
	if index == 0:
		_show_cards(TYPE_LOCOMOTIVE)
	elif index == 1:
		_show_cards(TYPE_COAL_TENDER)
	else:
		debug_label.text = selected_name + " (暂未实现)"
		return
	
	debug_label.text = "已展示: " + selected_name + "卡片，拖动到铁轨放置"

# ===== 卡片展示 =====
func _show_cards(type: String) -> void:
	current_card_type = type
	for child in card_container.get_children():
		child.queue_free()
	
	if not card_textures.has(type):
		card_title.text = "卡片加载失败"
		return
	
	var count: int = player_inventory.get(type, 0)
	if count == 0:
		card_title.text = "没有" + type_names.get(type, type) + "卡片"
		return
	
	card_title.text = type_names.get(type, type) + "卡片 x" + str(count) + " (拖动到铁轨上放置)"
	
	for i in range(count):
		var card := TextureRect.new()
		card.texture = card_textures[type]
		card.custom_minimum_size = card_size
		card.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		card.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		card.gui_input.connect(_on_card_gui_input.bind(type))
		card_container.add_child(card)

func _on_card_gui_input(event: InputEvent, type: String) -> void:
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				drag_mode = 1
				drag_card_type = type
				drag_vehicle_index = -1
				has_dragged = false
				drag_preview.texture = card_textures.get(type)
				drag_preview.size = card_size
				drag_preview.position = event.global_position - card_size / 2
				drag_preview.visible = true
			else:
				if drag_mode == 1 and has_dragged:
					_try_place_vehicle(event.global_position)
				_end_drag()

# ===== 输入处理 =====
func _input(event: InputEvent) -> void:
	# 卡片/车辆拖动优先处理
	if drag_mode != 0:
		if event is InputEventMouseButton:
			if event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
				if has_dragged:
					if drag_mode == 1:
						_try_place_vehicle(event.position)
					elif drag_mode == 2:
						_try_recycle_vehicle(event.position)
				_end_drag()
		elif event is InputEventMouseMotion:
			has_dragged = true
			var mouse_pos = event.position
			drag_preview.position = mouse_pos - drag_preview.size / 2
			
			var panel_top = view_h - card_panel_height
			if drag_mode == 1:
				# 从卡片拖出去放置
				if mouse_pos.y < panel_top:
					if drag_preview.texture != vehicle_textures.get(drag_card_type):
						drag_preview.texture = vehicle_textures.get(drag_card_type)
						var vscale: float = vehicle_target_height / vehicle_textures[drag_card_type].get_height()
						drag_preview.size = Vector2(
							vehicle_textures[drag_card_type].get_width() * vscale,
							vehicle_target_height
						)
				else:
					if drag_preview.texture != card_textures.get(drag_card_type):
						drag_preview.texture = card_textures.get(drag_card_type)
						drag_preview.size = card_size
			elif drag_mode == 2:
				# 从列车拖出去回收
				if mouse_pos.y > panel_top:
					if drag_preview.texture != card_textures.get(drag_card_type):
						drag_preview.texture = card_textures.get(drag_card_type)
						drag_preview.size = card_size
				else:
					if drag_preview.texture != vehicle_textures.get(drag_card_type):
						drag_preview.texture = vehicle_textures.get(drag_card_type)
						var vscale: float = vehicle_target_height / vehicle_textures[drag_card_type].get_height()
						drag_preview.size = Vector2(
							vehicle_textures[drag_card_type].get_width() * vscale,
							vehicle_target_height
						)
		return
	
	# 视差滚动
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				if event.position.y < view_h - card_panel_height:
					is_dragging_screen = true
					drag_start_mouse_x = event.position.x
					drag_start_scroll = target_scroll
					last_mouse_x = event.position.x
					momentum = 0
			else:
				is_dragging_screen = false
	elif event is InputEventMouseMotion:
		if is_dragging_screen:
			var dx: float = event.position.x - drag_start_mouse_x
			target_scroll = drag_start_scroll - dx
			if target_scroll < 0:
				target_scroll = 0
			if target_scroll > max_scroll:
				target_scroll = max_scroll
			momentum = last_mouse_x - event.position.x
			last_mouse_x = event.position.x

func _end_drag() -> void:
	drag_mode = 0
	drag_card_type = ""
	drag_vehicle_index = -1
	has_dragged = false
	drag_preview.visible = false

# ===== 车辆放置 =====
func _try_place_vehicle(mouse_pos: Vector2) -> void:
	var type = drag_card_type
	if type == "" or not vehicle_textures.has(type):
		return
	
	var panel_top = view_h - card_panel_height
	if mouse_pos.y > panel_top:
		return
	
	var insert_index = _calc_insert_index(mouse_pos.x)
	
	var error_msg = _check_placement_rules(type, insert_index)
	if error_msg != "":
		debug_label.text = "连挂失败: " + error_msg
		return
	
	_place_vehicle_at(type, insert_index)
	_save_train()
	debug_label.text = type_names.get(type, type) + "放置成功! 列车长度:" + str(placed_vehicles.size())

func _place_vehicle_at(type: String, insert_index: int) -> void:
	var vehicle_tex = vehicle_textures[type]
	var v_width = vehicle_scaled_widths[type]
	var flipped = _should_flip(type, insert_index)
	
	var v_node := TextureRect.new()
	v_node.texture = vehicle_tex
	v_node.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	v_node.stretch_mode = TextureRect.STRETCH_SCALE
	v_node.flip_h = flipped
	v_node.mouse_filter = Control.MOUSE_FILTER_STOP
	v_node.gui_input.connect(_on_vehicle_gui_input.bind(insert_index))
	placed_vehicles_node.add_child(v_node)
	
	var vehicle_data = {
		"type": type,
		"width": v_width,
		"flipped": flipped,
		"node": v_node
	}
	placed_vehicles.insert(insert_index, vehicle_data)
	
	# 更新后面所有车辆的 input 绑定索引
	_refresh_vehicle_input_indices()
	
	player_inventory[type] -= 1
	_rearrange_vehicles()
	_refresh_flips()
	
	if current_card_type != "":
		_show_cards(current_card_type)

func _should_flip(_type: String, _insert_index: int) -> bool:
	# 翻转状态由 _refresh_flips 统一计算，这里返回初始值即可
	return false

func _refresh_flips() -> void:
	var right_loco_idx = -1
	for i in range(placed_vehicles.size() - 1, -1, -1):
		if placed_vehicles[i].type == TYPE_LOCOMOTIVE:
			right_loco_idx = i
			break
	
	for i in range(placed_vehicles.size()):
		var v = placed_vehicles[i]
		if v.type == TYPE_LOCOMOTIVE:
			# 只有在最右端且不在最左端时才翻转（朝右）
			# 单个机车时（i==0且size==1）不翻转（朝左）
			v.flipped = (i == placed_vehicles.size() - 1 and i != 0)
		elif v.type == TYPE_COAL_TENDER:
			# 只有紧贴右侧机车左边的煤水车才翻转（朝右朝向机车）
			# 其他煤水车都不翻转（朝左）
			v.flipped = (right_loco_idx >= 0 and i == right_loco_idx - 1)
		v.node.flip_h = v.flipped

func _refresh_vehicle_input_indices() -> void:
	for i in range(placed_vehicles.size()):
		var v = placed_vehicles[i]
		v.node.gui_input.disconnect(_on_vehicle_gui_input)
		v.node.gui_input.connect(_on_vehicle_gui_input.bind(i))

func _on_vehicle_gui_input(event: InputEvent, index: int) -> void:
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				if index < 0 or index >= placed_vehicles.size():
					return
				var v = placed_vehicles[index]
				var v_tex = vehicle_textures[v.type]
				drag_mode = 2
				drag_card_type = v.type
				drag_vehicle_index = index
				has_dragged = false
				drag_preview.texture = v_tex
				drag_preview.size = Vector2(v.width, vehicle_target_height)
				drag_preview.position = event.global_position - Vector2(v.width / 2, vehicle_target_height / 2)
				drag_preview.visible = true
				# 临时隐藏被拖起的车辆
				v.node.visible = false

func _try_recycle_vehicle(mouse_pos: Vector2) -> void:
	if drag_vehicle_index < 0 or drag_vehicle_index >= placed_vehicles.size():
		return
	
	var panel_top = view_h - card_panel_height
	if mouse_pos.y < panel_top:
		# 拖回铁轨区域，放回去
		var vehicle = placed_vehicles[drag_vehicle_index]
		vehicle.node.visible = true
		return
	
	# 拖回面板，回收
	var type = drag_card_type
	var v = placed_vehicles[drag_vehicle_index]
	v.node.queue_free()
	placed_vehicles.remove_at(drag_vehicle_index)
	player_inventory[type] += 1
	
	_refresh_flips()
	_refresh_vehicle_input_indices()
	_rearrange_vehicles()
	_save_train()
	
	if current_card_type != "":
		_show_cards(current_card_type)
	
	debug_label.text = type_names.get(type, type) + "已回收"

func _calc_insert_index(mouse_x: float) -> int:
	if placed_vehicles.is_empty():
		return 0
	
	var start_x = view_w * train_start_x_ratio - scroll_x
	var total_width = 0.0
	for v in placed_vehicles:
		total_width += v.width
	var _end_x = start_x + total_width
	
	if mouse_x < start_x + total_width / 2:
		return 0
	return placed_vehicles.size()

func _check_placement_rules(type: String, insert_index: int) -> String:
	var new_size = placed_vehicles.size() + 1
	
	# 所有车辆只能放在列车两端（紧密相连）
	if insert_index != 0 and insert_index != placed_vehicles.size():
		return "车辆只能放在列车两端"
	
	if type == TYPE_LOCOMOTIVE:
		# 机车数量上限
		var loco_count = 0
		for v in placed_vehicles:
			if v.type == TYPE_LOCOMOTIVE:
				loco_count += 1
		if loco_count >= 2:
			return "机车数量已达上限（两端各一个）"
		# 检查放置后所有机车是否都在两端
		# 新机车位置就是insert_index
		# 原机车位置：index < insert_index 不变，index >= insert_index 后移一位
		for i in range(placed_vehicles.size()):
			if placed_vehicles[i].type == TYPE_LOCOMOTIVE:
				var new_pos = i
				if i >= insert_index:
					new_pos = i + 1
				if new_pos != 0 and new_pos != new_size - 1:
					return "放置后有机车不在两端，无法放置"
	elif type == TYPE_COAL_TENDER:
		if placed_vehicles.is_empty():
			return "煤水车不能单独放置，请先放机车"
		# 检查是否能连接到机车
		var has_loco = false
		for v in placed_vehicles:
			if v.type == TYPE_LOCOMOTIVE:
				has_loco = true
				break
		if not has_loco:
			return "煤水车必须与机车相连"
		# 当只有一个机车时，不能在它左边放置煤水车（会把机车推到右边）
		var loco_count = 0
		var leftmost_loco = -1
		for i in range(placed_vehicles.size()):
			if placed_vehicles[i].type == TYPE_LOCOMOTIVE:
				loco_count += 1
				if leftmost_loco < 0:
					leftmost_loco = i
		if loco_count == 1 and leftmost_loco == 0 and insert_index == 0:
			return "当只有一个机车时，不能在机车左边放置煤水车"
		# 检查放置后所有机车是否还在两端
		for i in range(placed_vehicles.size()):
			if placed_vehicles[i].type == TYPE_LOCOMOTIVE:
				var new_pos = i
				if i >= insert_index:
					new_pos = i + 1
				if new_pos != 0 and new_pos != new_size - 1:
					return "放置后有机车不在两端，无法放置"
	return ""

func _rearrange_vehicles() -> void:
	var total_width = 0.0
	for v in placed_vehicles:
		total_width += v.width
	
	max_scroll = total_width - view_w * 0.3
	if max_scroll < 0:
		max_scroll = 0
	if target_scroll > max_scroll:
		target_scroll = max_scroll
	
	var start_x = view_w * train_start_x_ratio - scroll_x
	var current_x = start_x
	
	for v in placed_vehicles:
		var node = v.node
		node.size = Vector2(v.width, vehicle_target_height)
		node.position = Vector2(current_x, rail_y - vehicle_target_height)
		current_x += v.width

# ===== 一键清除 =====
func _on_clear_all_pressed() -> void:
	if placed_vehicles.is_empty():
		debug_label.text = "列车上没有车辆"
		return
	
	# 回收所有车辆
	for v in placed_vehicles:
		v.node.queue_free()
		player_inventory[v.type] += 1
	
	placed_vehicles.clear()
	scroll_x = 0
	target_scroll = 0
	max_scroll = cf_scaled_width * train_length - view_w
	if max_scroll < 0:
		max_scroll = 0
	
	if current_card_type != "":
		_show_cards(current_card_type)
	
	_save_train()
	debug_label.text = "已清除所有车辆"

# ===== 编组保存/加载 =====
func _save_train() -> void:
	var save_data = {
		"placed_vehicles": [],
		"inventory": player_inventory
	}
	for v in placed_vehicles:
		save_data.placed_vehicles.append({
			"type": v.type,
			"flipped": v.flipped
		})
	
	var file = FileAccess.open(SAVE_PATH, FileAccess.WRITE)
	if file:
		file.store_string(JSON.stringify(save_data))
		file.close()

func _load_train_save() -> void:
	if not FileAccess.file_exists(SAVE_PATH):
		return
	
	var file = FileAccess.open(SAVE_PATH, FileAccess.READ)
	if not file:
		return
	
	var content = file.get_as_text()
	file.close()
	
	var parse_result = JSON.parse_string(content)
	if parse_result == null:
		return
	
	var data = parse_result
	
	# 初始总量
	var initial_total = {
		"locomotive": initial_locomotive_count,
		"coal_tender": initial_coal_tender_count
	}
	
	# 校验：库存 + 已放置 应该等于初始总量
	var saved_inventory = {}
	if data.has("inventory"):
		for key in data.inventory.keys():
			saved_inventory[key] = int(data.inventory[key])
	
	var saved_placed_count = {
		"locomotive": 0,
		"coal_tender": 0
	}
	if data.has("placed_vehicles"):
		for v_data in data.placed_vehicles:
			var vtype = v_data.type
			if saved_placed_count.has(vtype):
				saved_placed_count[vtype] += 1
	
	# 检查是否损坏
	var corrupted = false
	for key in initial_total.keys():
		var total = saved_inventory.get(key, 0) + saved_placed_count.get(key, 0)
		if total != initial_total[key] or saved_inventory.get(key, 0) < 0:
			corrupted = true
			break
	
	if corrupted:
		# 存档损坏，重置
		player_inventory = {
			"locomotive": initial_locomotive_count,
			"coal_tender": initial_coal_tender_count
		}
		return
	
	# 校验通过，加载
	for key in saved_inventory.keys():
		if player_inventory.has(key):
			player_inventory[key] = saved_inventory[key]
	
	if data.has("placed_vehicles"):
		for v_data in data.placed_vehicles:
			var vtype = v_data.type
			if not vehicle_textures.has(vtype):
				continue
			# 注意：保存的inventory已经是扣除后的剩余量，加载车辆时不要再扣
			var v_width = vehicle_scaled_widths[vtype]
			var v_node := TextureRect.new()
			v_node.texture = vehicle_textures[vtype]
			v_node.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			v_node.stretch_mode = TextureRect.STRETCH_SCALE
			v_node.mouse_filter = Control.MOUSE_FILTER_STOP
			placed_vehicles_node.add_child(v_node)
			
			placed_vehicles.append({
				"type": vtype,
				"width": v_width,
				"flipped": v_data.get("flipped", false),
				"node": v_node
			})
		
		# 刷新翻转和输入
		_refresh_flips()
		_refresh_vehicle_input_indices()
		_rearrange_vehicles()

func _on_back_pressed() -> void:
	_save_train()
	get_tree().change_scene_to_file("res://scenes/main.tscn")

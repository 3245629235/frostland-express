extends Control

@onready var debug_label: Label = $DebugLabel
@onready var resource_panel: Panel = $ResourcePanel
@onready var character_panel: Panel = $CharacterPanel
@onready var character_list: VBoxContainer = $CharacterPanel/CharacterList
@onready var train_panel: Panel = $TrainPanel
@onready var action_panel: Panel = $ActionPanel

@onready var food_label: Label = $ResourcePanel/ResourceGrid/Food/FoodLabel
@onready var fuel_label: Label = $ResourcePanel/ResourceGrid/Fuel/FuelLabel
@onready var medicine_label: Label = $ResourcePanel/ResourceGrid/Medicine/MedicineLabel
@onready var parts_label: Label = $ResourcePanel/ResourceGrid/Parts/PartsLabel
@onready var ammo_small_label: Label = $ResourcePanel/ResourceGrid/AmmoSmall/AmmoSmallLabel
@onready var ammo_large_label: Label = $ResourcePanel/ResourceGrid/AmmoLarge/AmmoLargeLabel

@onready var health_bar: ProgressBar = $TrainPanel/TrainStatus/HealthBar
@onready var health_label: Label = $TrainPanel/TrainStatus/HealthLabel
@onready var efficiency_label: Label = $TrainPanel/TrainStatus/EfficiencyLabel
@onready var morale_bar: ProgressBar = $TrainPanel/TrainStatus/MoraleBar
@onready var morale_label: Label = $TrainPanel/TrainStatus/MoraleLabel

@onready var travel_button: Button = $ActionPanel/ActionButtons/TravelButton
@onready var stop_button: Button = $ActionPanel/ActionButtons/StopButton
@onready var collect_button: Button = $ActionPanel/ActionButtons/CollectButton
@onready var repair_button: Button = $ActionPanel/ActionButtons/RepairButton
@onready var back_button: Button = $ActionPanel/ActionButtons/BackButton
@onready var home_button: Button = $ActionPanel/ActionButtons/HomeButton

var characters: Array = []
var is_traveling: bool = false
var is_stopped: bool = false
var travel_timer: float = 0.0
var consume_timer: float = 0.0
var collect_timer: float = 0.0
var is_collecting: bool = false

const CONSUME_INTERVAL: float = 2.0
const TRAVEL_DURATION: float = 30.0

func _ready() -> void:
	travel_button.pressed.connect(_on_travel_pressed)
	stop_button.pressed.connect(_on_stop_pressed)
	collect_button.pressed.connect(_on_collect_pressed)
	repair_button.pressed.connect(_on_repair_pressed)
	back_button.pressed.connect(_on_back_pressed)
	home_button.pressed.connect(_on_home_pressed)

	# GameState 是 Autoload 单例，数据已就绪
	_create_initial_characters()
	_update_all_ui()

	is_traveling = GameState.is_traveling
	if is_traveling:
		travel_button.disabled = true
		stop_button.disabled = false
		collect_button.disabled = true
		repair_button.disabled = true
		debug_label.text = "列车运行中 - 资源持续消耗"
	else:
		travel_button.disabled = false
		stop_button.disabled = true
		collect_button.disabled = false
		repair_button.disabled = false
		debug_label.text = "列车已停靠 - 可进行收集和维修"

func _create_initial_characters() -> void:
	characters = []
	# 优先使用 GameState 中的角色（从人员编成场景保存而来）
	var source: Array
	if not GameState.characters.is_empty():
		source = GameState.characters
	else:
		source = CharacterData.get_default_team()

	for cfg in source:
		var character = cfg.duplicate(true)
		# 确保生存模式所需的运行时字段存在
		if not character.has("exp"):
			character["exp"] = 0
		if not character.has("next_level_exp"):
			character["next_level_exp"] = 100
		character["hunger"] = character.get("hunger", 50)
		character["temperature"] = character.get("temperature", 90)
		character["morale"] = character.get("morale", 60)
		characters.append(character)

func _process(delta: float) -> void:
	if is_traveling:
		travel_timer += delta
		consume_timer += delta

		if consume_timer >= CONSUME_INTERVAL:
			_consume_resources()
			consume_timer = 0.0

		if travel_timer >= TRAVEL_DURATION:
			_on_travel_complete()

	if is_collecting:
		collect_timer += delta
		if collect_timer >= 5.0:
			_complete_collection()

	_update_all_ui()

func _consume_resources() -> void:
	var char_count = characters.size()
	var food_consume = char_count * 1
	var fuel_consume = 3

	if GameState.consume_resource("food", food_consume):
		_update_character_hunger(-2)
	else:
		_update_character_hunger(-5)

	GameState.consume_resource("fuel", fuel_consume)

	_update_character_temperature()
	_update_character_stamina()

func _update_character_hunger(delta: int) -> void:
	for character in characters:
		character.hunger = clamp(character.hunger + delta, 0, 100)
		if character.hunger < 20:
			character.health -= 1

func _update_character_temperature() -> void:
	for character in characters:
		character.temperature = clamp(character.temperature - 1, 0, 100)
		if character.temperature < 30:
			character.health -= 1

func _update_character_stamina() -> void:
	for character in characters:
		if is_traveling:
			character.stamina = clamp(character.stamina - 2, 0, character.max_stamina)
		else:
			character.stamina = clamp(character.stamina + 1, 0, character.max_stamina)

func _complete_collection() -> void:
	is_collecting = false
	collect_timer = 0.0

	var food_gain = randf_range(5, 15)
	var fuel_gain = randf_range(3, 10)

	GameState.add_resource("food", int(food_gain))
	GameState.add_resource("fuel", int(fuel_gain))

	debug_label.text = "收集完成: 食物+%d, 燃料+%d" % [food_gain, fuel_gain]

	collect_button.disabled = false

	if randf_range(0, 1) < 0.3:
		debug_label.text += " (遭遇敌人威胁!)"

func _on_repair_pressed() -> void:
	var repair_cost = 10
	if not GameState.consume_resource("parts", repair_cost):
		debug_label.text = "零件不足 (需要 %d)!" % repair_cost
		return

	var current_health = GameState.train.health
	var repair_amount = 20
	var new_health = current_health + repair_amount

	if is_stopped:
		# 停车状态 - 可以进行更全面的维修
		if current_health >= 90:
			new_health = 100.0
		elif current_health >= 50:
			new_health = min(current_health + repair_amount, 90.0)
		elif current_health >= 25:
			new_health = min(current_health + repair_amount * 0.5, 50.0)
		else:
			debug_label.text = "列车损坏过重 (血量 < 25%%)，无法在停车状态修理!"
			GameState.add_resource("parts", repair_cost)
			return
	else:
		# 行驶状态 - 只能进行轻度维修
		if current_health >= 90:
			new_health = 100.0
		elif current_health >= 50:
			new_health = min(current_health + repair_amount, 90.0)
		else:
			debug_label.text = "行驶中无法修理低血量列车 (血量 < 50%%)!"
			GameState.add_resource("parts", repair_cost)
			return

	GameState.set_train_health(new_health)
	debug_label.text = "修理完成! 血量: %.0f/%.0f" % [new_health, GameState.train.max_health]

func _on_travel_pressed() -> void:
	if is_traveling:
		return

	is_traveling = true
	GameState.is_traveling = true
	is_stopped = false
	travel_timer = 0.0

	travel_button.disabled = true
	stop_button.disabled = false
	collect_button.disabled = true
	repair_button.disabled = true

	debug_label.text = "列车出发! 预计行驶 %.0f 秒" % TRAVEL_DURATION

func _on_stop_pressed() -> void:
	if not is_traveling:
		return

	is_traveling = false
	GameState.is_traveling = false
	is_stopped = true

	travel_button.disabled = false
	stop_button.disabled = true
	collect_button.disabled = false
	repair_button.disabled = false

	debug_label.text = "列车已停靠，可以收集物资或维修"

func _on_travel_complete() -> void:
	is_traveling = false
	travel_timer = 0.0

	travel_button.disabled = false
	stop_button.disabled = true
	collect_button.disabled = false
	repair_button.disabled = false

	debug_label.text = "到达新节点! 可探索或继续前进"
	GameState.add_resource("food", 5)
	GameState.add_resource("parts", 3)

func _on_collect_pressed() -> void:
	if is_collecting:
		return

	is_collecting = true
	collect_timer = 0.0
	collect_button.disabled = true
	debug_label.text = "正在收集物资... (5秒)"

func _update_all_ui() -> void:
	_update_resource_ui()
	_update_train_ui()
	_update_character_ui()

func _update_resource_ui() -> void:
	food_label.text = "食物: %d" % GameState.get_resource("food")
	fuel_label.text = "燃料: %d" % GameState.get_resource("fuel")
	medicine_label.text = "药品: %d" % GameState.get_resource("medicine")
	parts_label.text = "零件: %d" % GameState.get_resource("parts")
	ammo_small_label.text = "小弹药: %d" % GameState.get_resource("ammo_small")
	ammo_large_label.text = "大弹药: %d" % GameState.get_resource("ammo_large")

func _update_train_ui() -> void:
	var health = GameState.train.health
	var max_health = GameState.train.max_health
	var efficiency = GameState.get_train_efficiency()

	health_bar.value = health
	health_label.text = "列车血量: %.0f/%.0f" % [health, max_health]
	efficiency_label.text = "效率: %.0f%%" % (efficiency * 100)

	morale_bar.value = GameState.morale
	morale_label.text = "士气: %.0f%%" % GameState.morale

func _update_character_ui() -> void:
	for child in character_list.get_children():
		child.queue_free()

	for character in characters:
		var panel = Panel.new()
		panel.custom_minimum_size = Vector2(0, 60)
		character_list.add_child(panel)

		var hbox = HBoxContainer.new()
		hbox.add_theme_constant_override("separation", 10)
		hbox.offset_left = 10
		hbox.offset_top = 5
		hbox.offset_right = -10
		hbox.offset_bottom = -5
		panel.add_child(hbox)

		var name_label = Label.new()
		name_label.text = character.name
		name_label.add_theme_font_size_override("font_size", 14)
		name_label.add_theme_color_override("font_color", Color(1, 1, 1))
		hbox.add_child(name_label)

		var status_vbox = VBoxContainer.new()
		hbox.add_child(status_vbox)

		var health_pbar = ProgressBar.new()
		health_pbar.custom_minimum_size = Vector2(80, 12)
		health_pbar.value = character.health
		health_pbar.max_value = character.max_health
		status_vbox.add_child(health_pbar)

		var status_text = "%d/%d HP | 饥饿:%d%% | 体温:%d%%" % [
			character.health, character.max_health, character.hunger, character.temperature
		]
		var status_label = Label.new()
		status_label.text = status_text
		status_label.add_theme_font_size_override("font_size", 11)
		status_vbox.add_child(status_label)

func _on_back_pressed() -> void:
	GameState.save_state()
	get_tree().change_scene_to_file("res://scenes/team.tscn")

func _on_home_pressed() -> void:
	GameState.save_state()
	get_tree().change_scene_to_file("res://scenes/main.tscn")

func _exit_tree() -> void:
	GameState.save_state()
